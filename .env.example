# ─────────────────────────────────────────────────────────────
# Sano — variables de entorno
# Copiá este archivo a ".env.local" para desarrollo local.
# En Vercel, cargá estas variables en Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Panel del dueño (login) ---
# Cambiá esta contraseña por una tuya antes de publicar.
ADMIN_PASSWORD=sano-2bistro
# Secreto para firmar la sesión del panel (poné cualquier texto largo y aleatorio).
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# --- Base de datos (Upstash Redis / Vercel KV) ---
# Se completan solas si conectás un store "KV" (Upstash) desde el panel de Vercel.
# Para Upstash directo, usá las UPSTASH_* .
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa (Upstash directo):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Negocio (opcional; hay valores por defecto en el código) ---
# Número de WhatsApp de Sano en formato internacional, sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP=50683193498
